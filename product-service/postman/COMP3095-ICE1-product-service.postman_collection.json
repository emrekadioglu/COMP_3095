{
  "info": {
    "name": "COMP3095 ICE1 product-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "F1 POST create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.id) { pm.collectionVariables.set('productId', json.id); }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"Ergonomic wireless mouse\",\n  \"price\": 29.99\n}"
        },
        "url": { "raw": "http://localhost:8080/api/product", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "product"] }
      }
    },
    {
      "name": "F2 GET all products",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8080/api/product", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "product"] }
      }
    },
    {
      "name": "F3 PUT update product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse Pro\",\n  \"description\": \"Updated ergonomic wireless mouse\",\n  \"price\": 39.99\n}"
        },
        "url": { "raw": "http://localhost:8080/api/product/{{productId}}", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "product", "{{productId}}"] }
      }
    },
    {
      "name": "F4 GET after update",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8080/api/product", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "product"] }
      }
    },
    {
      "name": "F5 DELETE product",
      "request": {
        "method": "DELETE",
        "url": { "raw": "http://localhost:8080/api/product/{{productId}}", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "product", "{{productId}}"] }
      }
    },
    {
      "name": "F6 GET after delete",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8080/api/product", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "product"] }
      }
    }
  ],
  "variable": [
    { "key": "productId", "value": "" }
  ]
}
